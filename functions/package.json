    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "index.js",
  "dependencies": {
    "@google/genai": "^2.21.0",
    "axios": "^1.20.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1"
  },
  "private": true,
  "allowScripts": {
    "rss-parser@3.13.0": true,
    "axios@1.20.0": true,
    "@google/genai@2.21.0": true
  }
}
